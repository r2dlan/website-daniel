{
  "name": "website-daniel",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2 <2"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "test": "vitest run",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "validate": "bun run format:check && bun run check && bun run build",
    "preview": "astro preview",
    "preview:cloudflare": "astro build && wrangler dev",
    "deploy": "astro build && wrangler deploy"
  },
  "dependencies": {
    "astro": "7.4.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "vitest": "4.1.12",
    "wrangler": "4.158.0"
  }
}
