---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CharacterCounter from "../../components/CharacterCounter.astro";
import { languages } from "../../lib/i18n";

const contactEndpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT ?? "https://YOUR-WORKER.example.workers.dev/contact";

const lang = "en";
const t = languages[lang];
---

<BaseLayout lang={lang}>
  <main>
    <section class="card home-hero home-hero--split">
      <div class="home-hero__content">
        <p class="hero-name">{t.heroLabel}</p>
        <h1>{t.heroSubtitle}</h1>
        <div class="section-text section-text--hero">
          <p>I’m fascinated by technology — but even more by what you can do with it. I want to understand how things work, question existing solutions, and keep trying whether something could be simpler, better, or completely different.</p>
          <p>That leads to new ideas and projects again and again: sometimes around software, cloud, and artificial intelligence, sometimes while building and experimenting, and sometimes simply out of a spontaneous idea where I want to know: does this actually work?</p>
          <p>I like clear, pragmatic solutions and things that create real value. At the same time, I want to stay curious, try new things, and follow ideas even when it’s not yet clear where they will lead.</p>
          <p>That’s why this site is not a finished portfolio, but more a personal place for what occupies me: projects, experiences, thoughts, and things I learn along the way.</p>
          <p>And it will probably never be completely finished. Which would be a bit boring, really.</p>
        </div>
        <p><a class="button button--primary" href={t.projectsPath}>{t.heroCta}</a></p>
      </div>
      <div class="home-hero__visual" aria-hidden="true">
        <div class="home-hero__art">
          <img src="/hero-portrait.png" alt="" loading="eager" decoding="async" />
        </div>
      </div>
    </section>

    <section class="card home-section home-experience">
      <div class="home-experience__header">
        <p class="eyebrow">{t.experienceLabel}</p>
      </div>
      <div class="home-experience__list">
        {t.experience.map((item) => (
          <details class="home-experience__item" open={item.year === "2022 – present"}>
            <summary>
              <div class="home-experience__rail" aria-hidden="true">
                <span class="home-experience__dot"></span>
              </div>
              <div class="home-experience__body home-experience__summary">
                <div class="home-experience__summary-top">
                  <p class="home-experience__meta">{item.year}</p>
                  <span class="home-experience__toggle" data-toggle-label>{item.year === "2022 – present" ? "Less" : "More"}</span>
                </div>
                <h2>{item.role}</h2>
                <p class="home-experience__company">{item.company} · {item.location}</p>
              </div>
            </summary>
            <div class="home-experience__body home-experience__details">
              <ul>
                {item.bullets.map((point) => <li>{point}</li>)}
              </ul>
            </div>
          </details>
        ))}
      </div>
    </section>

    <script is:inline>
      document.querySelectorAll(".home-experience__item").forEach((details) => {
        const toggle = details.querySelector("[data-toggle-label]");
        if (!toggle) return;

        const sync = () => {
          toggle.textContent = details.open ? "Less" : "More";
        };

        sync();
        details.addEventListener("toggle", sync);
      });
    </script>

    <section class="card home-contact">
      <div class="home-contact__intro">
        <p class="eyebrow">{t.contactLabel}</p>
        <p>{t.contactIntro}</p>
      </div>
      <form class="home-contact__form" data-contact-form data-endpoint={contactEndpoint}>
        <label>
          <span class="sr-only">{t.contactPlaceholderEmail}</span>
          <input type="email" name="email" placeholder={t.contactPlaceholderEmail} required />
        </label>
        <label class="sr-only" aria-hidden="true">
          Website
          <input type="text" name="website" tabindex="-1" autocomplete="off" />
        </label>
        <label>
          <span class="sr-only">Message</span>
          <textarea id="message" name="message" maxlength="5000" rows="6" placeholder={t.contactPlaceholderMessage} required></textarea>
        </label>
        <CharacterCounter textareaId="message" max={5000} />
        <button class="button button--dark" type="submit">{t.contactSubmit}</button>
        <p class="home-contact__status" aria-live="polite" data-contact-status></p>
      </form>
    </section>
  </main>

  <script>
      const forms = document.querySelectorAll("[data-contact-form]");
      forms.forEach((form) => {
        form.addEventListener("submit", async (event) => {
          event.preventDefault();
          const target = event.currentTarget;
          if (!(target instanceof HTMLFormElement)) return;

          const endpoint = target.dataset.endpoint;
          if (!endpoint) return;

          const status = target.querySelector("[data-contact-status]");
          if (status instanceof HTMLElement) {
            status.className = "home-contact__status";
            status.textContent = "";
          }

          const data = new FormData(target);
          const response = await fetch(endpoint, {
            method: "POST",
            body: data,
          });

          if (response.ok) {
            target.reset();
            if (status instanceof HTMLElement) {
              status.textContent = "Thanks! Your message has been sent.";
              status.classList.add("home-contact__status--success");
            }
          } else {
            if (status instanceof HTMLElement) {
              status.textContent = "Sorry, the message could not be sent right now.";
              status.classList.add("home-contact__status--error");
            }
          }
        });
      });
    </script>
</BaseLayout>
