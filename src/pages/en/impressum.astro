---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { languages } from "../../lib/i18n";

const lang = "en";
const t = languages[lang];
---

<BaseLayout lang={lang}>
  <main>
    <section class="card" style="max-width: 760px; padding: 48px;">
      <p class="eyebrow">{t.legalTitle}</p>
      <h1>{t.imprintTitle}</h1>
      <p>{t.imprintIntro}</p>
      <p>
        <a href="/en/legal/">{t.footerImprint}</a>
      </p>
    </section>
  </main>
</BaseLayout>
