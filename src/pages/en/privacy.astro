---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { languages } from "../../lib/i18n";

const lang = "en";
const t = languages[lang];
---

<BaseLayout title={`${t.privacyTitle} — Daniel Andres`} lang={lang}>
  <main>
    <article class="card" style="padding: 32px;">
      <p class="eyebrow">{t.legalTitle}</p>
      <h1>{t.privacyTitle}</h1>
      <p>{t.privacyIntro}</p>
      <h2 style="margin-top: 28px; font-size: 1.1rem;">Hosting and delivery</h2>
      <p>{t.privacyFonts}</p>
      <p>{t.privacyCloudflare}</p>
      <p>{t.privacyLogs}</p>
      <h2 style="margin-top: 28px; font-size: 1.1rem;">Contact form</h2>
      <p>{t.privacyContact}</p>
      <p>{t.privacyStorage}</p>
      <h2 style="margin-top: 28px; font-size: 1.1rem;">Cookies and tracking</h2>
      <p>{t.privacySocial}</p>
      <p>{t.privacyCookies}</p>
    </article>
  </main>
</BaseLayout>
