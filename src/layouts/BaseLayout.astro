---
import { languages, type LanguageCode } from "../lib/i18n";
import LanguageNav from "../components/LanguageNav.astro";
import "../styles/global.css";

const { title = "Daniel Andres — About, Work, Tech", lang = "de" } = Astro.props as {
  title?: string;
  lang?: LanguageCode;
};

const content = languages[lang] ?? languages.de;
const currentYear = new Date().getFullYear();

const socialLinks = [
  {
    label: "Xing",
    href: "https://www.xing.com/profile/Daniel_Andres12",
    icon: "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4.5 5.5h3.2l2.2 4.1-3.1 5.1H3.7l3.2-5.1L4.5 5.5Zm8.1-2h3l4.4 7.8-5.1 9.2h-3.1l5.2-9.2-4.4-7.8Z\"/></svg>",
  },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/daniel-andres-683384214/",
    icon: "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 8.5V19H2.3V8.5H5Zm-1.3-1.3A1.6 1.6 0 1 1 3.7 4a1.6 1.6 0 0 1 0 3.2ZM20 19h-2.7v-5.1c0-1.2 0-2.7-1.7-2.7s-2 1.3-2 2.6V19H10.9V8.5h2.6v1.4h.1c.4-.8 1.4-1.7 3-1.7 3.2 0 3.8 2.1 3.8 4.8V19Z\"/></svg>",
  },
  {
    label: "GitHub r2dlan",
    href: "https://github.com/r2dlan",
    icon: "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 2A10 10 0 0 0 8.8 21.5c.5.1.6-.2.6-.4v-1.5c-2.4.5-2.9-1-2.9-1-.4-1-.9-1.3-.9-1.3-.8-.6.1-.6.1-.6.9.1 1.4.9 1.4.9.8 1.4 2.1 1 2.6.8.1-.6.3-1 .6-1.3-1.9-.2-3.9-1-3.9-4.3 0-1 .4-1.8 1-2.4-.1-.2-.4-1.1.1-2.3 0 0 .9-.3 2.5 1a8.4 8.4 0 0 1 4.6 0c1.6-1.3 2.5-1 2.5-1 .5 1.2.2 2.1.1 2.3.6.6 1 1.4 1 2.4 0 3.3-2 4.1-3.9 4.3.3.3.7.9.7 1.9v2.8c0 .2.1.5.6.4A10 10 0 0 0 12 2Z\"/></svg>",
  },
  {
    label: "GitHub andredni",
    href: "https://github.com/andredni",
    icon: "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 2A10 10 0 0 0 8.8 21.5c.5.1.6-.2.6-.4v-1.5c-2.4.5-2.9-1-2.9-1-.4-1-.9-1.3-.9-1.3-.8-.6.1-.6.1-.6.9.1 1.4.9 1.4.9.8 1.4 2.1 1 2.6.8.1-.6.3-1 .6-1.3-1.9-.2-3.9-1-3.9-4.3 0-1 .4-1.8 1-2.4-.1-.2-.4-1.1.1-2.3 0 0 .9-.3 2.5 1a8.4 8.4 0 0 1 4.6 0c1.6-1.3 2.5-1 2.5-1 .5 1.2.2 2.1.1 2.3.6.6 1 1.4 1 2.4 0 3.3-2 4.1-3.9 4.3.3.3.7.9.7 1.9v2.8c0 .2.1.5.6.4A10 10 0 0 0 12 2Z\"/></svg>",
  },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <div class="site-header__actions">
          <nav class="site-header__nav" aria-label="Primary">
            <a href={`/${lang}/`}>{content.navStart}</a>
            <a href={`/${lang}/${lang === "en" ? "projects" : "projekte"}/`}>{content.navProjects}</a>
          </nav>
          <LanguageNav lang={lang} path={Astro.url.pathname} />
        </div>
      </header>
      <main class="site-shell__content">
        <slot />
      </main>
      <footer class="site-footer site-shell__footer">
        <div class="site-footer__inner">
          <div class="site-footer__section">
            <p class="eyebrow">{content.legalTitle}</p>
            <nav class="site-footer__nav" aria-label="Legal">
              <a href={lang === "de" ? "/de/impressum/" : "/en/legal/"}>{content.footerImprint}</a>
              <a href={lang === "de" ? "/de/datenschutz/" : "/en/privacy/"}>{content.footerPrivacy}</a>
            </nav>
          </div>
          <div class="site-footer__section">
            <p class="eyebrow">{content.footerConnect}</p>
            <div class="site-footer__socials">
              {socialLinks.map((link) => (
                <a href={link.href} target="_blank" rel="noreferrer noopener" aria-label={link.label} title={link.label}>
                  <span class="site-footer__social-icon" set:html={link.icon}></span>
                </a>
              ))}
            </div>
          </div>
        </div>
        <p class="site-footer__copyright">{content.footerCopyright.replace("{year}", String(currentYear))}</p>
      </footer>
    </div>
  </body>
</html>
